---
interface Props {
  id?: string;
  size?: 'default' | 'large';
}
const { id = 'waitlist', size = 'default' } = Astro.props;
---

<div id={id} class="waitlist-form-wrapper">
  <form
    class="waitlist-form flex flex-col sm:flex-row gap-3"
    data-form-id={id}
    novalidate
  >
    <input
      type="email"
      name="email"
      placeholder="Enter your email"
      required
      autocomplete="email"
      class:list={[
        'flex-1 rounded-xl border border-gray-200 bg-white px-4 text-[var(--color-heading)] placeholder:text-[var(--color-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-blue-accent)] focus:border-transparent transition',
        size === 'large' ? 'h-14 text-base' : 'h-12 text-sm',
      ]}
    />
    <button
      type="submit"
      class:list={[
        'flex-shrink-0 bg-[var(--color-blue-accent)] hover:bg-[var(--color-blue-dark)] text-white font-heading font-600 rounded-xl transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed',
        size === 'large' ? 'h-14 px-8 text-base' : 'h-12 px-6 text-sm',
      ]}
    >
      Get Early Access
    </button>
  </form>

  <div class="waitlist-success hidden mt-4 p-4 rounded-xl bg-[var(--color-blue-tint)] border border-[var(--color-blue-accent)]/20">
    <p class="text-sm font-heading font-600 text-[var(--color-heading)]">
      You're on the list!
    </p>
    <p class="text-sm text-[var(--color-body)] mt-0.5">
      We'll email you when StackWise launches on the App Store.
    </p>
  </div>

  <p class="mt-3 text-xs text-[var(--color-muted)]">
    Be the first to know when StackWise launches on the App Store.
  </p>
</div>

<script>
  const KIT_FORM_ID = '9457828';
  const KIT_API_KEY = import.meta.env.PUBLIC_KIT_API_KEY;

  document.querySelectorAll<HTMLFormElement>('.waitlist-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const wrapper = form.closest('.waitlist-form-wrapper') as HTMLElement;
      const successEl = wrapper?.querySelector('.waitlist-success') as HTMLElement;
      const btn = form.querySelector('button') as HTMLButtonElement;
      const input = form.querySelector('input[type="email"]') as HTMLInputElement;

      const email = input.value.trim();
      if (!email) return;

      btn.disabled = true;
      btn.textContent = 'Joining...';

      try {
        const res = await fetch(
          `https://api.convertkit.com/v3/forms/${KIT_FORM_ID}/subscribe`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ api_key: KIT_API_KEY, email }),
          }
        );

        if (res.ok) {
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
          wrapper.querySelector('p.mt-3')?.classList.add('hidden');
        } else {
          btn.disabled = false;
          btn.textContent = 'Get Early Access';
          alert('Something went wrong. Please try again.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Get Early Access';
        alert('Something went wrong. Please try again.');
      }
    });
  });
</script>
