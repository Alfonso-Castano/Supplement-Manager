---
const credibilitySignals = [
  { icon: '📚', text: 'Every record citation-backed from NIH, PubMed, MSK, MedlinePlus, or OpenFDA' },
  { icon: '✅', text: 'Human-verified against original sources' },
  { icon: '🔍', text: 'Confidence-filtered — low-confidence records excluded' },
  { icon: '💊', text: 'Covers the most commonly taken supplements and prescribed medications' },
  { icon: '🔔', text: "Honest about gaps — items not in the database are clearly flagged" },
];
---

<section class="py-24 px-6 bg-[var(--color-blue-tint)]">
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Privacy -->
      <div class="flex flex-col gap-5">
        <span class="fade-up text-xs font-heading font-600 uppercase tracking-widest text-[var(--color-blue-accent)]">
          Privacy
        </span>
        <h2 class="fade-up delay-1 text-3xl font-heading font-700 text-[var(--color-heading)] tracking-tight leading-snug">
          Your health data never leaves your device
        </h2>
        <p class="fade-up delay-2 text-base text-[var(--color-body)] leading-relaxed">
          No cloud accounts. No server-side storage. No health data transmitted — ever. StackWise runs entirely on your iPhone.
        </p>
        <div class="fade-up delay-3 mt-2 flex items-start gap-3 p-4 rounded-2xl bg-white/70 border border-white">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-blue-accent)]/10 flex items-center justify-center flex-shrink-0 text-lg">🔒</div>
          <p class="text-sm text-[var(--color-body)] leading-relaxed pt-1">
            The only outbound data is optional feedback you choose to send — which never includes health information.
          </p>
        </div>
      </div>

      <!-- Database credibility -->
      <div class="flex flex-col gap-5">
        <span class="fade-up text-xs font-heading font-600 uppercase tracking-widest text-[var(--color-green-accent)]">
          Data Integrity
        </span>
        <h2 class="fade-up delay-1 text-3xl font-heading font-700 text-[var(--color-heading)] tracking-tight leading-snug">
          Built from research, not algorithms
        </h2>
        <p class="fade-up delay-2 text-base text-[var(--color-body)] leading-relaxed">
          The interaction database was built through structured research from authoritative medical sources — not generated by AI.
        </p>
        <ul class="fade-up delay-3 flex flex-col gap-3 mt-1">
          {credibilitySignals.map((signal) => (
            <li class="flex items-start gap-3">
              <span class="text-base flex-shrink-0 mt-0.5">{signal.icon}</span>
              <span class="text-sm text-[var(--color-body)] leading-snug">{signal.text}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
