---
import WaitlistForm from './WaitlistForm.astro';
---

<section class="py-24 px-6 bg-[var(--color-heading)]">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-heading font-800 text-white tracking-tight mb-4 text-balance">
      Your stack, optimized.
    </h2>
    <p class="fade-up delay-1 text-base text-white/70 mb-8">
      Be the first to know when StackWise launches on the App Store.
    </p>

    <div class="fade-up delay-2 max-w-md mx-auto">
      <WaitlistForm id="footer-waitlist" size="large" variant="dark" />
    </div>

    <p class="fade-up delay-3 mt-8 text-xs text-white/40 uppercase tracking-widest font-heading font-500">
      Coming soon to the App Store
    </p>
  </div>
</section>
