---
---

<section class="py-24 px-6 bg-[var(--color-off-white)]">
  <div class="max-w-lg mx-auto text-center">
    <span class="fade-up inline-block text-xs font-heading font-600 uppercase tracking-widest text-[var(--color-blue-accent)] mb-4">
      Pricing
    </span>
    <h2 class="fade-up delay-1 text-3xl sm:text-4xl font-heading font-700 text-[var(--color-heading)] tracking-tight mb-10 text-balance">
      Simple, transparent pricing
    </h2>

    <div class="fade-up delay-2 bg-white rounded-3xl border border-gray-100 shadow-sm p-10 flex flex-col items-center gap-5">
      <div class="w-full rounded-2xl bg-[var(--color-blue-tint)] px-5 py-4 text-center">
        <p class="text-sm font-heading font-700 text-[var(--color-heading)]">14-day free trial</p>
        <p class="text-xs text-[var(--color-body)] mt-1">Full access to everything — no credit card required</p>
      </div>

      <div class="w-full flex flex-col sm:flex-row gap-4">
        <div class="flex-1 rounded-2xl border border-gray-100 px-5 py-5 text-center">
          <p class="text-2xl font-heading font-800 text-[var(--color-heading)]">$4.99</p>
          <p class="text-xs text-[var(--color-muted)] mt-1">per month</p>
        </div>
        <div class="flex-1 rounded-2xl border-2 border-[var(--color-blue-accent)]/30 bg-[var(--color-blue-tint)]/50 px-5 py-5 text-center relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[var(--color-blue-accent)] text-white text-[10px] font-heading font-600 px-3 py-0.5 rounded-full uppercase tracking-wide">
            Best value
          </span>
          <p class="text-2xl font-heading font-800 text-[var(--color-heading)]">$35</p>
          <p class="text-xs text-[var(--color-muted)] mt-1">per year · saves ~40%</p>
        </div>
      </div>

      <p class="text-xs text-[var(--color-muted)]">No credit card required to join the waitlist.</p>
    </div>
  </div>
</section>
