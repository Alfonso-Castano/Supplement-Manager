---
const sources = [
  'NIH Office of Dietary Supplements',
  'PubMed',
  'Memorial Sloan Kettering',
  'MedlinePlus',
  'OpenFDA',
];
---

<section class="py-10 px-6 bg-[var(--color-blue-tint)]">
  <div class="max-w-6xl mx-auto text-center">
    <p class="fade-up text-xs font-heading font-500 uppercase tracking-widest text-[var(--color-muted)] mb-6">
      Interaction data built from sources you trust
    </p>
    <div class="flex flex-wrap justify-center items-center gap-x-8 gap-y-3">
      {sources.map((source, i) => (
        <span
          class={`text-sm font-heading font-600 text-[var(--color-body)] opacity-70 fade-up delay-${i + 1}`}
        >
          {source}
        </span>
      ))}
    </div>
  </div>
</section>
