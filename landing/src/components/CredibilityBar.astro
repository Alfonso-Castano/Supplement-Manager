---
const sources = [
  { domain: 'nih.gov',                                   name: 'NIH Office of Dietary Supplements' },
  { domain: 'pubmed.ncbi.nlm.nih.gov',                   name: 'PubMed' },
  { domain: 'mskcc.org',                                 name: 'Memorial Sloan Kettering' },
  { domain: 'medlineplus.gov',                           name: 'MedlinePlus' },
  { domain: 'open.fda.gov',                              name: 'OpenFDA' },
  { domain: 'cochranelibrary.com',                       name: 'Cochrane Library' },
  { domain: 'who.int',                                   name: 'World Health Organization' },
  { domain: 'naturalmedicines.therapeuticresearch.com',  name: 'Natural Medicines' },
];
---

<section class="pt-8 pb-14 px-0 bg-[var(--color-blue-tint)] overflow-hidden">
  <div class="max-w-6xl mx-auto text-center mb-10 px-6">
    <p class="fade-up text-xs font-heading font-500 uppercase tracking-widest text-[var(--color-muted)]">
      Interaction data built from sources you trust
    </p>
  </div>

  <div class="cred-marquee-wrapper">
    <div class="cred-marquee-track">
      {[...sources, ...sources, ...sources].map((source) => (
        <span class="cred-marquee-pill">
          <img
            src={`https://www.google.com/s2/favicons?domain=${source.domain}&sz=64`}
            alt=""
            class="cred-logo"
            loading="lazy"
          />
          {source.name}
        </span>
      ))}
    </div>
  </div>
</section>
